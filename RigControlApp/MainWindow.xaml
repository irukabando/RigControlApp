<Window x:Class="RigControlApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rig Controller Developed by Iruka Bando" Height="580" Width="760"
        Background="#F1F5F9" Foreground="#0F172A"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#334155"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#0F172A"/>
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FontSize" Value="13"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="#FFFFFF"/>
            <Setter Property="BorderBrush" Value="#CBD5E1"/>
            <Setter Property="Foreground" Value="#1E293B"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="4" SnapsToDevicePixels="True">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#E2E8F0"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- 1. 接続バー -->
            <RowDefinition Height="Auto"/>
            <!-- 2. ディスプレイ表示 & 大型4連メーター -->
            <RowDefinition Height="Auto"/>
            <!-- 3. コントロール (バンド/モード/フィルタ/VFO/ANT/PTT/ATU) -->
            <RowDefinition Height="*"/>
            <!-- 4. ログ出力エリア -->
        </Grid.RowDefinitions>

        <!-- 1. 接続バー -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,6" Margin="0,0,0,8">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="設定:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="CmbConfig" Width="140" Height="28" Margin="0,0,12,0"/>

                <TextBlock Text="COM:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold"/>
                <ComboBox x:Name="CmbPort" Width="85" Height="28" Margin="0,0,12,0"/>

                <Button x:Name="BtnConnect" Content="接続" Width="65" Height="28" Background="#0284C7" Foreground="#FFFFFF" BorderBrush="#0284C7" Click="BtnConnect_Click"/>
                <Ellipse x:Name="LedStatus" Width="10" Height="10" Fill="#94A3B8" Margin="14,0,0,0" VerticalAlignment="Center"/>
                <TextBlock x:Name="TxtStatus" Text="未接続" VerticalAlignment="Center" Margin="6,0,0,0" Foreground="#64748B" FontWeight="Bold" FontSize="13"/>
            </StackPanel>
        </Border>

        <!-- 2. ディスプレイ表示 & 視認性を大幅向上させた大型4連メーター -->
        <Border Grid.Row="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="14,10" Margin="0,0,0,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="280"/>
                </Grid.ColumnDefinitions>

                <!-- 周波数表示 -->
                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtVfoTitle" Text="VFO-A (Hz)" Foreground="#64748B" FontSize="12" FontWeight="Bold"/>

                    <!-- 桁マーカー -->
                    <Canvas Height="14" Margin="0,2,0,0" ClipToBounds="False">
                        <TextBlock x:Name="TxtMarker" Text="▼" Foreground="#0284C7" FontSize="12" FontWeight="Bold" Canvas.Left="0" Canvas.Top="0"/>
                    </Canvas>

                    <!-- 周波数メイン表示 -->
                    <TextBox x:Name="TxtFreqMain" Text="014.074.000" FontFamily="Consolas" FontSize="36" FontWeight="Bold"
                             Foreground="#0F172A" Background="Transparent" BorderThickness="0"
                             CaretBrush="Transparent" SelectionBrush="Transparent" IsReadOnly="True" Cursor="Hand"
                             SelectionChanged="TxtFreqMain_SelectionChanged"
                             PreviewKeyDown="TxtFreqMain_PreviewKeyDown" MouseWheel="TxtFreqMain_MouseWheel"
                             PreviewMouseDown="TxtFreqMain_PreviewMouseDown"
                             Margin="0,-2,0,0" Padding="0"/>

                    <!-- サブ VFO 表示 -->
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <TextBlock x:Name="TxtSubVfoLabel" Text="SUB VFO: " Foreground="#94A3B8" FontSize="12" FontWeight="SemiBold"/>
                        <TextBlock x:Name="TxtFreqSub" Text="---.---.--- Hz" Foreground="#475569" FontFamily="Consolas" FontSize="12" FontWeight="Bold"/>
                    </StackPanel>
                </StackPanel>

                <!-- 大型4連メーター (S, PO, SWR, ALC) -->
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                    <!-- Sメーター (SIG) -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SIG" FontSize="11" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <ProgressBar x:Name="PbSMeter" Height="12" Minimum="0" Maximum="255" Value="0"
                                         Foreground="#0284C7" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1"/>
                            <Grid Margin="0,1,0,0">
                                <TextBlock Text="S1" FontSize="9" Foreground="#64748B" HorizontalAlignment="Left"/>
                                <TextBlock Text="S9" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="+60dB" FontSize="9" Foreground="#EF4444" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- POWER メーター (PO) -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="PO" FontSize="11" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <ProgressBar x:Name="PbPowerMeter" Height="12" Minimum="0" Maximum="255" Value="0"
                                         Foreground="#10B981" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1"/>
                            <Grid Margin="0,1,0,0">
                                <TextBlock Text="0" FontSize="9" Foreground="#64748B" HorizontalAlignment="Left"/>
                                <TextBlock Text="50W" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="100W+" FontSize="9" Foreground="#10B981" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- SWR メーター -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="SWR" FontSize="11" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <ProgressBar x:Name="PbSwrMeter" Height="12" Minimum="0" Maximum="255" Value="0"
                                         Foreground="#F59E0B" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1"/>
                            <Grid Margin="0,1,0,0">
                                <TextBlock Text="1.0" FontSize="9" Foreground="#64748B" HorizontalAlignment="Left"/>
                                <TextBlock Text="1.5" FontSize="9" Foreground="#64748B" HorizontalAlignment="Center"/>
                                <TextBlock Text="3.0+" FontSize="9" Foreground="#EF4444" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Grid>

                    <!-- ALC メーター -->
                    <Grid Margin="0,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="ALC" FontSize="11" FontWeight="Bold" Foreground="#8B5CF6" VerticalAlignment="Center"/>
                        <StackPanel Grid.Column="1">
                            <ProgressBar x:Name="PbAlcMeter" Height="12" Minimum="0" Maximum="255" Value="0"
                                         Foreground="#8B5CF6" Background="#E2E8F0" BorderBrush="#CBD5E1" BorderThickness="1"/>
                            <Grid Margin="0,1,0,0">
                                <TextBlock Text="MIN" FontSize="9" Foreground="#64748B" HorizontalAlignment="Left"/>
                                <TextBlock Text="ZONE" FontSize="9" Foreground="#8B5CF6" HorizontalAlignment="Center"/>
                                <TextBlock Text="MAX" FontSize="9" Foreground="#EF4444" FontWeight="Bold" HorizontalAlignment="Right"/>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 3. コントロール (バンド/モード/フィルタ/VFO/ANT/PTT/ATU) -->
        <Grid Grid.Row="2" Margin="0,0,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.3*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- バンド、フィルタ＆モード切替 -->
            <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="0,0,4,0">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>

                        <!-- バンド選択 -->
                        <StackPanel Orientation="Horizontal" Grid.Column="0" Margin="0,0,6,0">
                            <TextBlock Text="BAND:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold"/>
                            <ComboBox x:Name="CmbBand" Width="105" Height="28" SelectionChanged="CmbBand_SelectionChanged">
                                <ComboBoxItem Content="1.9 MHz" Tag="1.9MHz"/>
                                <ComboBoxItem Content="3.5 MHz" Tag="3.5MHz"/>
                                <ComboBoxItem Content="7 MHz" Tag="7MHz"/>
                                <ComboBoxItem Content="10 MHz" Tag="10MHz"/>
                                <ComboBoxItem Content="14 MHz" Tag="14MHz"/>
                                <ComboBoxItem Content="18 MHz" Tag="18MHz"/>
                                <ComboBoxItem Content="21 MHz" Tag="21MHz"/>
                                <ComboBoxItem Content="24 MHz" Tag="24MHz"/>
                                <ComboBoxItem Content="28 MHz" Tag="28MHz"/>
                                <ComboBoxItem Content="50 MHz" Tag="50MHz"/>
                                <ComboBoxItem Content="144 MHz" Tag="144MHz"/>
                                <ComboBoxItem Content="430 MHz" Tag="430MHz"/>
                            </ComboBox>
                        </StackPanel>

                        <!-- フィルタ帯域調整 -->
                        <StackPanel Orientation="Horizontal" Grid.Column="1">
                            <TextBlock Text="FILT:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Bold"/>
                            <ComboBox x:Name="CmbFilter" Width="105" Height="28" IsEditable="True" SelectionChanged="CmbFilter_SelectionChanged"/>
                        </StackPanel>
                    </Grid>

                    <!-- モード選択ボタン群 -->
                    <WrapPanel x:Name="PanelModes">
                        <Button Content="LSB" Width="48" Height="26" Margin="0,0,4,4" Click="ModeButton_Click"/>
                        <Button Content="USB" Width="48" Height="26" Margin="0,0,4,4" Click="ModeButton_Click"/>
                        <Button Content="CW" Width="48" Height="26" Margin="0,0,4,4" Click="ModeButton_Click"/>
                        <Button Content="FM" Width="48" Height="26" Margin="0,0,4,4" Click="ModeButton_Click"/>
                        <Button Content="AM" Width="48" Height="26" Margin="0,0,4,4" Click="ModeButton_Click"/>
                        <Button Content="DATA-USB" Width="78" Height="26" Margin="0,0,0,4" Click="ModeButton_Click"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!-- VFO & アンテナ & スイッチ (PTT / ATU) -->
            <Border Grid.Column="1" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="10,8" Margin="4,0,0,0">
                <StackPanel VerticalAlignment="Center">
                    <!-- VFO 選択 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="VFO:" VerticalAlignment="Center" Margin="0,0,6,0" Width="36" FontWeight="Bold"/>
                        <Button x:Name="BtnVfoA" Content="VFO-A" Width="68" Height="26" Margin="0,0,6,0" Background="#0284C7" Foreground="#FFFFFF" BorderBrush="#0284C7" Click="BtnVfoA_Click"/>
                        <Button x:Name="BtnVfoB" Content="VFO-B" Width="68" Height="26" Background="#FFFFFF" Foreground="#334155" BorderBrush="#CBD5E1" Click="BtnVfoB_Click"/>
                    </StackPanel>

                    <!-- アンテナ選択 -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                        <TextBlock Text="ANT:" VerticalAlignment="Center" Margin="0,0,6,0" Width="36" FontWeight="Bold"/>
                        <ComboBox x:Name="CmbAntenna" Width="142" Height="26" SelectionChanged="CmbAntenna_SelectionChanged">
                            <ComboBoxItem Content="ANT 1" Tag="1"/>
                            <ComboBoxItem Content="ANT 2" Tag="2"/>
                            <ComboBoxItem Content="ANT 3" Tag="3"/>
                            <ComboBoxItem Content="ANT 4" Tag="4"/>
                        </ComboBox>
                    </StackPanel>

                    <!-- PTT & ATU スイッチ -->
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnPtt" Content="RX [受信]" Width="96" Height="28" Margin="0,0,6,0"
                                Background="#E2E8F0" Foreground="#1E293B" BorderBrush="#CBD5E1" FontWeight="Bold" Click="BtnPtt_Click"/>
                        <Button x:Name="BtnTuner" Content="ATU: OFF" Width="88" Height="28"
                                Background="#E2E8F0" Foreground="#1E293B" BorderBrush="#CBD5E1" FontWeight="Bold" Click="BtnTuner_Click"/>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 4. ログ出力エリア -->
        <Border Grid.Row="3" Background="#FFFFFF" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="6" Padding="2" MinHeight="50">
            <TextBox x:Name="TxtLog" Background="Transparent" Foreground="#334155" BorderThickness="0"
                     FontFamily="Consolas" FontSize="11" IsReadOnly="True" VerticalScrollBarVisibility="Auto" Padding="6"/>
        </Border>
    </Grid>
</Window>