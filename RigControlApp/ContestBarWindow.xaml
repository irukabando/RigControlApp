<Window x:Class="RigControlApp.ContestBarWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rig Control - Contest Bar"
        Height="62" Width="980"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        Topmost="True" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI, Yu Gothic UI, Meiryo"
        MouseDown="Window_MouseDown">

    <Border Background="#FFFFFF" BorderBrush="#0284C7" BorderThickness="1.5" CornerRadius="8" Margin="3">
        <Border.Effect>
            <DropShadowEffect Color="#0F172A" BlurRadius="6" ShadowDepth="2" Opacity="0.25"/>
        </Border.Effect>

        <Grid Margin="6,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="BtnReturnDetail" Content="詳細 ↩" Width="52" Height="28" Margin="0,0,4,0"
                        Background="#F1F5F9" Foreground="#0284C7" BorderBrush="#CBD5E1" FontWeight="Bold" FontSize="11"
                        ToolTip="通常（詳細）画面に戻る" Click="BtnReturnDetail_Click"/>

                <ToggleButton x:Name="BtnTopmost" Content="📌" Width="28" Height="28" Margin="0,0,6,0"
                              IsChecked="True" ToolTip="常に最前面に表示" Click="BtnTopmost_Click"/>

                <Border Background="#F8FAFC" BorderBrush="#CBD5E1" BorderThickness="1" CornerRadius="4" Padding="2" Margin="0,0,4,0">
                    <StackPanel Orientation="Horizontal">
                        <Button x:Name="BtnVfoA" Content="A" Width="22" Height="22" Margin="1,0"
                                Background="#0284C7" Foreground="#FFFFFF" BorderThickness="0" FontWeight="Bold" FontSize="11"
                                Click="BtnVfoA_Click"/>
                        <Button x:Name="BtnVfoB" Content="B" Width="22" Height="22" Margin="1,0"
                                Background="Transparent" Foreground="#64748B" BorderThickness="0" FontWeight="Bold" FontSize="11"
                                Click="BtnVfoB_Click"/>
                    </StackPanel>
                </Border>

                <Border Background="#E0F2FE" BorderBrush="#BAE6FD" BorderThickness="1" CornerRadius="4" Padding="6,2" VerticalAlignment="Center">
                    <TextBlock x:Name="TxtCurrentMode" Text="USB" Foreground="#0369A1" FontWeight="Bold" FontSize="12"/>
                </Border>
            </StackPanel>

            <Rectangle Grid.Column="1" Width="1" Fill="#E2E8F0" Height="36" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="2,0">
                <Canvas Height="10" ClipToBounds="False" Margin="0,0,0,-2">
                    <TextBlock x:Name="TxtMarker" Text="▼" Foreground="#0284C7" FontSize="10" FontWeight="Bold" Canvas.Left="0" Canvas.Top="0"/>
                </Canvas>
                <TextBox x:Name="TxtFreqMain" Text="014.074.000" FontFamily="Consolas" FontSize="26" FontWeight="Bold"
                         Foreground="#0F172A" Background="Transparent" BorderThickness="0"
                         CaretBrush="Transparent" SelectionBrush="Transparent" IsReadOnly="True" Cursor="Hand"
                         SelectionChanged="TxtFreqMain_SelectionChanged"
                         PreviewKeyDown="TxtFreqMain_PreviewKeyDown" MouseWheel="TxtFreqMain_MouseWheel"
                         PreviewMouseDown="TxtFreqMain_PreviewMouseDown"
                         Padding="0" VerticalAlignment="Center"/>
            </StackPanel>

            <Rectangle Grid.Column="3" Width="1" Fill="#E2E8F0" Height="36" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="4" VerticalAlignment="Center">
                <Button x:Name="BtnPtt" Content="RX [受信]" Width="78" Height="34"
                        Background="#E2E8F0" Foreground="#1E293B" BorderBrush="#CBD5E1" FontWeight="Bold" FontSize="12"
                        Cursor="Hand" Click="BtnPtt_Click"/>
            </StackPanel>

            <Rectangle Grid.Column="5" Width="1" Fill="#E2E8F0" Height="36" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="6" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="ANT:" VerticalAlignment="Center" Margin="0,0,4,0" FontWeight="Bold" FontSize="11" Foreground="#64748B"/>
                <ComboBox x:Name="CmbAntenna" Width="72" Height="26" FontSize="11" SelectionChanged="CmbAntenna_SelectionChanged">
                    <ComboBoxItem Content="ANT 1" Tag="1"/>
                    <ComboBoxItem Content="ANT 2" Tag="2"/>
                    <ComboBoxItem Content="ANT 3" Tag="3"/>
                    <ComboBoxItem Content="ANT 4" Tag="4"/>
                </ComboBox>
            </StackPanel>

            <Rectangle Grid.Column="7" Width="1" Fill="#E2E8F0" Height="36" VerticalAlignment="Center"/>

            <!-- 5. 4連コンパクトメーター (S, PO, SWR, ALC) -->
            <Grid Grid.Column="8" VerticalAlignment="Center" Margin="2,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="2"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="8"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 上段左: Sメーター -->
                <Grid Grid.Row="0" Grid.Column="0" Cursor="Hand" ToolTip="クリックでメーター切替 (SM_SET / PO_SET)" PreviewMouseDown="Meter_PreviewMouseDown" Tag="SM">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="S" FontSize="10" FontWeight="Bold" Foreground="#0284C7" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="PbSMeter" Grid.Column="1" Height="9" Minimum="0" Maximum="255" Value="0"
                                 Foreground="#0284C7" Background="#E2E8F0" BorderThickness="0"/>
                </Grid>

                <!-- 上段右: POメーター -->
                <Grid Grid.Row="0" Grid.Column="2" Cursor="Hand" ToolTip="クリックでメーター切替 (PO_SET)" PreviewMouseDown="Meter_PreviewMouseDown" Tag="PO">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="PO" FontSize="10" FontWeight="Bold" Foreground="#10B981" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="PbPowerMeter" Grid.Column="1" Height="9" Minimum="0" Maximum="255" Value="0"
                                 Foreground="#10B981" Background="#E2E8F0" BorderThickness="0"/>
                </Grid>

                <!-- 下段左: SWRメーター -->
                <Grid Grid.Row="2" Grid.Column="0" Cursor="Hand" ToolTip="クリックでメーター切替 (SWR_SET)" PreviewMouseDown="Meter_PreviewMouseDown" Tag="SWR">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="SWR" FontSize="9" FontWeight="Bold" Foreground="#F59E0B" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="PbSwrMeter" Grid.Column="1" Height="9" Minimum="0" Maximum="255" Value="0"
                                 Foreground="#F59E0B" Background="#E2E8F0" BorderThickness="0"/>
                </Grid>

                <!-- 下段右: ALCメーター -->
                <Grid Grid.Row="2" Grid.Column="2" Cursor="Hand" ToolTip="クリックでメーター切替 (ALC_SET)" PreviewMouseDown="Meter_PreviewMouseDown" Tag="ALC">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="26"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="ALC" FontSize="9" FontWeight="Bold" Foreground="#8B5CF6" VerticalAlignment="Center"/>
                    <ProgressBar x:Name="PbAlcMeter" Grid.Column="1" Height="9" Minimum="0" Maximum="255" Value="0"
                                 Foreground="#8B5CF6" Background="#E2E8F0" BorderThickness="0"/>
                </Grid>
            </Grid>

            <Rectangle Grid.Column="9" Width="1" Fill="#E2E8F0" Height="36" VerticalAlignment="Center"/>

            <StackPanel Grid.Column="10" Orientation="Horizontal" VerticalAlignment="Center" Margin="2,0,0,0">
                <Button x:Name="BtnMinimize" Content="－" Width="22" Height="24" Margin="0,0,2,0"
                        Background="Transparent" BorderThickness="0" Foreground="#64748B" FontSize="11" FontWeight="Bold"
                        ToolTip="最小化" Click="BtnMinimize_Click"/>
                <Button x:Name="BtnClose" Content="✕" Width="22" Height="24"
                        Background="Transparent" BorderThickness="0" Foreground="#EF4444" FontSize="11" FontWeight="Bold"
                        ToolTip="アプリを終了" Click="BtnClose_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>